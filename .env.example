# PayPal sandbox app. Must belong to a sandbox business account in a country that
# can send payouts (for example the US). Leash refuses to start unless PAYPAL_ENV=sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# LLM used for policy drafting, explanations and the demo agent. Get a free key at console.groq.com.
# Leash still enforces policy without a key. Leave AI_MODEL empty for the provider default.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=

PORT=3000

# API key the demo agent uses to reach Leash. Change it on a public deployment.
LEASH_DEMO_AGENT_KEY=leash-demo-key

# Protects approvals, policy changes and demo controls. Agents never receive it.
# Without it, anyone who can reach the server can approve payments.
DASHBOARD_PASSWORD=
# Optional: shown on the password prompt. Only for public demos, never a real deployment.
DASHBOARD_PASSWORD_HINT=

# Comma-separated sandbox personal account emails, seeded as verified vendors
DEMO_VENDOR_EMAILS=

# Optional SQLite file path
LEASH_DB=
